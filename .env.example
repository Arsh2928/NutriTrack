# NutriTrack AI Provider Configuration (valid: gemini, groq, offline)
NUTRITRACK_AI_MODE=offline

# Google Gemini API (used exclusively when mode=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Groq API (used exclusively when mode=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Retry, Timeout and Circuit Breaker Settings
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=20
AI_RETRY_BASE_DELAY_SECONDS=1
AI_RETRY_MAX_DELAY_SECONDS=8
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=60
AI_HEALTH_CHECK_INTERVAL_SECONDS=60

# Flask Settings
FLASK_ENV=development
PORT=5000
